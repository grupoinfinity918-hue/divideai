generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  CLIENT
  SELLER
  ADMIN
  SUPPORT
}

enum KycStatus {
  PENDING
  APPROVED
  REJECTED
}

enum ListingOrigin {
  OWN
  THIRD_PARTY
}

enum ListingStatus {
  ACTIVE
  PENDING_APPROVAL
  REJECTED
  PAUSED
}

enum CommissionMode {
  FIXED
  PERCENT
}

enum OrderStatus {
  AWAITING_PAYMENT
  PAID
  AWAITING_DELIVERY
  DELIVERED
  IN_WARRANTY
  COMPLETED
  DISPUTED
  REFUNDED
  CANCELLED
}

enum WalletTxType {
  SALE_HOLD
  SALE_RELEASE
  REFUND
  COMMISSION
  WITHDRAWAL
}

enum WalletTxStatus {
  HELD
  RELEASED
  REVERSED
}

enum ChatStatus {
  AWAITING_SHIPMENT
  IN_WARRANTY
  COMPLETED
  DISPUTED
}

enum SenderType {
  CLIENT
  SELLER
  SUPPORT
}

enum SeasonalTheme {
  DEFAULT
  CHRISTMAS
  NEW_YEAR
  CARNIVAL
  SAO_JOAO
}

enum WhatsappEvent {
  PIX_CONFIRMED_SELLER
  DELIVERY_CONFIRMED_CLIENT
}

model User {
  id            String     @id @default(uuid())
  name          String
  email         String     @unique
  phone         String
  passwordHash  String
  role          UserRole   @default(CLIENT)
  customCommissionRate Float @default(5.0)
  cpf           String?    @unique
  birthDate     DateTime?
  address       String?
  idDocUrl      String?
  avatarUrl     String?
  storeName     String?
  storeColor    String?
  storeBannerUrl String?
  kycStatus     KycStatus  @default(PENDING)
  banned        Boolean    @default(false)
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  wallet          Wallet?
  listings        Listing[]
  commissionTiers CommissionTier[]
  ordersAsClient  Order[]          @relation("ClientOrders")
  ordersAsSeller  Order[]          @relation("SellerOrders")
  chatsAsClient   Chat[]           @relation("ClientChats")
  chatsAsSeller   Chat[]           @relation("SellerChats")
  messages        ChatMessage[]
  reviewsGiven    Review[]         @relation("ReviewAuthor")
  reviewsReceived Review[]         @relation("ReviewTarget")
  withdrawals     WithdrawalRequest[]
  preSaleChatsAsClient PreSaleChat[] @relation("PreSaleClientChats")
  preSaleChatsAsSeller PreSaleChat[] @relation("PreSaleSellerChats")
  reports         Report[]
  supportChats    SupportChat[]
  preSaleMessages PreSaleMessage[] @relation("PreSaleMessageSender")
  supportMessages SupportMessage[] @relation("SupportMessageSender")
}

model Wallet {
  id            String        @id @default(uuid())
  userId        String        @unique
  user          User          @relation(fields: [userId], references: [id])
  balanceHeld   Decimal       @default(0) @db.Decimal(12, 2)
  balanceFree   Decimal       @default(0) @db.Decimal(12, 2)
  transactions  WalletTransaction[]
  updatedAt     DateTime      @updatedAt
}

model WalletTransaction {
  id         String          @id @default(uuid())
  walletId   String
  wallet     Wallet          @relation(fields: [walletId], references: [id])
  orderId    String?
  order      Order?          @relation(fields: [orderId], references: [id])
  type       WalletTxType
  status     WalletTxStatus  @default(HELD)
  amount     Decimal         @db.Decimal(12, 2)
  releaseAt  DateTime?
  createdAt  DateTime        @default(now())
}

model CommissionTier {
  id         String          @id @default(uuid())
  sellerId   String
  seller     User            @relation(fields: [sellerId], references: [id])
  minValue   Decimal         @db.Decimal(12, 2)
  maxValue   Decimal         @db.Decimal(12, 2)
  mode       CommissionMode
  value      Decimal         @db.Decimal(12, 2)
  createdAt  DateTime        @default(now())
}

model Category {
  id        String     @id @default(uuid())
  name      String     @unique
  slug      String     @unique
  iconUrl   String?
  order     Int        @default(0)
  listings  Listing[]
}

model Listing {
  id             String          @id @default(uuid())
  sellerId       String
  seller         User            @relation(fields: [sellerId], references: [id])
  categoryId     String
  category       Category        @relation(fields: [categoryId], references: [id])
  origin         ListingOrigin
  title          String
  description    String
  price          Decimal         @db.Decimal(12, 2)
  status         ListingStatus   @default(ACTIVE)
  isPrioritario  Boolean         @default(false)
  slotsTotal     Int?
  slotsAvailable Int?
  rules          String?
  billingPeriod  String          @default("mensal")
  icon           String          @default("tv")
  autoDelivery   Boolean         @default(false)
  autoDeliveryPayload String?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  edits    ListingEdit[]
  orders   Order[]
  preSaleChats PreSaleChat[]
}

model ListingEdit {
  id           String       @id @default(uuid())
  listingId    String
  listing      Listing      @relation(fields: [listingId], references: [id])
  beforeData   Json
  afterData    Json
  status       ListingStatus @default(PENDING_APPROVAL)
  reviewedBy   String?
  reviewedAt   DateTime?
  createdAt    DateTime     @default(now())
}

model Order {
  id            String        @id @default(uuid())
  protocol      String        @unique
  listingId     String
  listing       Listing       @relation(fields: [listingId], references: [id])
  clientId      String
  client        User          @relation("ClientOrders", fields: [clientId], references: [id])
  sellerId      String
  seller        User          @relation("SellerOrders", fields: [sellerId], references: [id])
  amount        Decimal       @db.Decimal(12, 2)
  commissionAmt Decimal       @db.Decimal(12, 2) @default(0)
  netToSeller   Decimal       @db.Decimal(12, 2) @default(0)
  status        OrderStatus   @default(AWAITING_PAYMENT)
  pixTxId       String?
  paidAt        DateTime?
  deliveredAt   DateTime?
  holdReleaseAt DateTime?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  walletTxs     WalletTransaction[]
  chat          Chat?
  reviews       Review[]
  notifications WhatsappNotification[]
}

model Chat {
  id         String        @id @default(uuid())
  protocol   String        @unique
  orderId    String        @unique
  order      Order         @relation(fields: [orderId], references: [id])
  clientId   String
  client     User          @relation("ClientChats", fields: [clientId], references: [id])
  sellerId   String
  seller     User          @relation("SellerChats", fields: [sellerId], references: [id])
  status     ChatStatus    @default(AWAITING_SHIPMENT)
  tripartite Boolean       @default(false)
  supportId  String?
  lastReadClient DateTime?
  lastReadSeller DateTime?
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt

  messages   ChatMessage[]
}

model ChatMessage {
  id         String      @id @default(uuid())
  chatId     String
  chat       Chat        @relation(fields: [chatId], references: [id])
  senderId   String
  sender     User        @relation(fields: [senderId], references: [id])
  senderType SenderType
  content    String
  attachmentUrl String?
  createdAt  DateTime    @default(now())
}

model Review {
  id         String   @id @default(uuid())
  orderId    String
  order      Order    @relation(fields: [orderId], references: [id])
  authorId   String
  author     User     @relation("ReviewAuthor", fields: [authorId], references: [id])
  targetId   String
  target     User     @relation("ReviewTarget", fields: [targetId], references: [id])
  stars      Int
  comment    String?
  createdAt  DateTime @default(now())
}

model WhatsappNotification {
  id        String        @id @default(uuid())
  orderId   String
  order     Order         @relation(fields: [orderId], references: [id])
  event     WhatsappEvent
  toPhone   String
  cost      Decimal       @default(0.04) @db.Decimal(6, 2)
  sentAt    DateTime?
  success   Boolean       @default(false)
  createdAt DateTime      @default(now())
}

enum WithdrawalStatus {
  PENDING
  PAID
  REJECTED
}

enum PixKeyType {
  CPF
  EMAIL
  PHONE
  RANDOM
}

model WithdrawalRequest {
  id         String           @id @default(uuid())
  sellerId   String
  seller     User             @relation(fields: [sellerId], references: [id])
  amount     Decimal          @db.Decimal(12, 2)
  pixKeyType PixKeyType
  pixKey     String
  status     WithdrawalStatus @default(PENDING)
  paidAt     DateTime?
  createdAt  DateTime         @default(now())
}

enum ReportTargetType {
  LISTING
  USER
  CHAT
}

enum ReportStatus {
  OPEN
  RESOLVED
}

model PreSaleChat {
  id         String              @id @default(uuid())
  protocol   String              @unique
  listingId  String
  listing    Listing             @relation(fields: [listingId], references: [id])
  clientId   String
  client     User                @relation("PreSaleClientChats", fields: [clientId], references: [id])
  sellerId   String
  seller     User                @relation("PreSaleSellerChats", fields: [sellerId], references: [id])
  lastReadClient DateTime?
  lastReadSeller DateTime?
  createdAt  DateTime            @default(now())
  updatedAt  DateTime            @updatedAt

  messages   PreSaleMessage[]

  @@unique([listingId, clientId])
}

model PreSaleMessage {
  id         String       @id @default(uuid())
  chatId     String
  chat       PreSaleChat  @relation(fields: [chatId], references: [id])
  senderId   String
  sender     User         @relation("PreSaleMessageSender", fields: [senderId], references: [id])
  senderType SenderType
  content    String
  createdAt  DateTime     @default(now())
}

model SupportChat {
  id         String            @id @default(uuid())
  protocol   String            @unique
  userId     String
  user       User              @relation(fields: [userId], references: [id])
  status     ChatStatus        @default(AWAITING_SHIPMENT)
  lastReadUser DateTime?
  lastReadSupport DateTime?
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt

  messages   SupportMessage[]
}

model SupportMessage {
  id         String       @id @default(uuid())
  chatId     String
  chat       SupportChat  @relation(fields: [chatId], references: [id])
  senderId   String
  sender     User         @relation("SupportMessageSender", fields: [senderId], references: [id])
  senderType SenderType
  content    String
  createdAt  DateTime     @default(now())
}

model Report {
  id         String            @id @default(uuid())
  reporterId String
  reporter   User              @relation(fields: [reporterId], references: [id])
  targetType ReportTargetType
  targetId   String
  reason     String
  status     ReportStatus      @default(OPEN)
  createdAt  DateTime          @default(now())
}

model AdminSettings {
  id                String         @id @default("singleton")
  activeTheme       SeasonalTheme  @default(DEFAULT)
  homepageOrder     Json           @default("[\"OWN\",\"THIRD_PARTY\"]")
  aiChatEnabled     Boolean        @default(true)
  updatedAt         DateTime       @updatedAt
}
